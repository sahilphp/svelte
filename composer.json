{
    "name": "sahilphp/svelte",
    "description": "SahilPHP starter-kit for Svelte 5 and TypeScript projects",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "sahilphp",
        "starter-kit",
        "svelte",
        "typescript",
        "vite"
    ],
    "homepage": "https://github.com/sahilphp/starter-kit-svelte",
    "support": {
        "issues": "https://github.com/sahilphp/starter-kit-svelte/issues",
        "source": "https://github.com/sahilphp/starter-kit-svelte"
    },
    "require": {
        "php": "^8.2",
        "sahilphp/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "@php sahil start",
        "test": "phpunit --configuration phpunit.xml --colors=always",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php bin/sahil key:generate",
            "@php bin/sahil storage:prepare"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
