{
    "name": "sahilphp/svelte",
    "description": "Svelte UI integration for SahilPHP applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sahilphp",
        "svelte",
        "typescript",
        "vite"
    ],
    "homepage": "https://github.com/sahilphp/svelte",
    "support": {
        "issues": "https://github.com/sahilphp/svelte/issues",
        "source": "https://github.com/sahilphp/svelte"
    },
    "require": {
        "php": "^8.2",
        "sahilphp/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --colors=always",
        "post-create-project-cmd": [
        "start": "sahil dev",
            "@php scripts/refuse-create-project.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
