# SahilPHP Svelte starter-kit environment
#
# Copy to `.env` (or let `composer create-project` do it) and adjust values.
# Every value is optional: without `.env` the application uses the defaults.

APP_NAME=SahilPHP
APP_KEY=
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_TIMEZONE=UTC
APP_LOG_LEVEL=info

# Vite development server URL. `public/hot` wins when it exists, so a Vite
# server that picked a different port still works without editing this file.
VITE_DEV_SERVER=http://127.0.0.1:5173

# Set explicitly to override the environment-derived asset mode.
# FRONTEND_DEVELOPMENT=true
