#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * SahilPHP public entry point.
 *
 * This file only loads Composer and delegates to the framework console. The
 * command implementations live in the installed `sahilphp/framework` package.
 */

$autoload = __DIR__.'/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, 'SahilPHP: vendor/autoload.php is missing. Run `composer install` first.'.PHP_EOL);
    exit(1);
}

require $autoload;

exit((new Sahil\Console\Application(__DIR__))->run(array_values(array_slice($argv, 1))));
